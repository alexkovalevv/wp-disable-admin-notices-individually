msgstr "Скачайте zip-файл плагина"

#. Found in installation list item.
msgid "Click \"Install Now\" and then \"Activate\""
msgstr "Нажмите \"Установить\", затем \"Активировать\""

#. Found in installation list item.
msgid "Search for \"Unnotifier\""
msgstr "Найдите \"Unnotifier\""

#. Found in installation list item.
msgid "Navigate to Plugins → Add New"
msgstr "Перейдите в Плагины → Добавить новый"

#. Found in installation list item.
msgid "Go to your WordPress admin area"
msgstr "Перейдите в админ-панель WordPress"

#. Found in installation header.
msgid "After Installation"
msgstr "После установки"

#. Found in installation header.
msgid "Manual Installation"
msgstr "Ручная установка"

#. Found in installation header.
